{
  "name": "commander",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "SSH_AUTH_SOCK": null
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/.secrets/**": true
        },
        "search.exclude": {
          "**/.secrets": true,
          "**/tools": true
        }
      }
    }
  }
}