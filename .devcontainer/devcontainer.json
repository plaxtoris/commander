{
  "name": "commander",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "init": true,
  "containerEnv": {
    "GOCACHE": "/workspace/.data/build",
    "GOMODCACHE": "/workspace/.data/modules"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ]
    }
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true
}
